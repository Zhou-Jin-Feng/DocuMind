# API 与模型配置
DEFAULT_EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding
# 可选：无法访问 Ollama 探测维度时使用；qwen3-embedding 默认 4096
OLLAMA_EMBEDDING_DIMENSIONS=

DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# RAG 参数
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=3
# Milvus L2 距离上限；v2.0.7 校准未找到可安全推荐的全局值，保持留空
RETRIEVAL_SCORE_THRESHOLD=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# 数据与 Web 服务
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
COLLECTION_NAME=rag_documents
DOCUMENT_REGISTRY_PATH=./data/document_registry.sqlite3
DEFAULT_TENANT_ID=default
DEFAULT_USER_ID=local-user
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=[".pdf", ".docx", ".txt"]
SERVER_HOST=127.0.0.1
SERVER_PORT=7860
SHARE_GRADIO=false
API_HOST=127.0.0.1
API_PORT=8001
API_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Milvus/Ollama readiness 单次探测超时（秒）
READINESS_PROBE_TIMEOUT_SECONDS=2

# 应用与日志
SERVICE_NAME=rag-web
APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/rag_{time:YYYY-MM-DD}.jsonl
LOG_ROTATION=500 MB
LOG_RETENTION=10 days
LOG_CONSOLE_FORMAT=text
LOG_FILE_FORMAT=json

# Metrics（默认仅监听本机）
METRICS_ENABLED=true
METRICS_HOST=127.0.0.1
METRICS_PORT=8000

# OpenTelemetry Tracing（默认关闭；未配置 endpoint 时不发送网络请求）
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
