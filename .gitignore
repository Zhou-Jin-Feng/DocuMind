# 忽略虚拟环境
venv/
env/
.venv/

# 忽略API密钥配置
.env

# 忽略Python缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 忽略IDE配置
.vscode/
.idea/
*.swp
*.swo

# 忽略数据库文件
*.db
*.sqlite
chroma_db/
*_chroma_db/

# 忽略新的数据目录
data/chroma_db/
data/uploads/
data/document_registry.sqlite3
data/evaluation_chroma_db*/
data/*_smoke.sqlite3
data/*_smoke_uploads/
data/evaluation_sources/

# Milvus Standalone data is external to this repo. Keep local Milvus data out of Git
# if a future manual installation places it under the workspace.
data/milvus/
volumes/milvus/

# 忽略日志文件
*.log
/logs/*
!/logs/.gitignore

# 忽略临时文件
.DS_Store
Thumbs.db

# 忽略测试覆盖率
.coverage
htmlcov/
.pytest_cache/

# 忽略构建文件
build/
dist/
*.egg-info/
frontend/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
/test-results/

# 本地工作与学习文档（不提交到仓库）
CLAUDE.md
RAG系统工程化优化与版本演进指南.md
local_docs/
.kilo/

# Agent工作文件
agent/

# Private local materials and tool state
/_private/
/.serena/
/.playwright-mcp/
/graphify-out/
/.claude/
/pelican-bike-animation.html
/docs/rag-pipeline-animation.html

# Local environment variants; keep the credential-free example trackable
.env.*
!.env.example

# Runtime directory skeletons are versioned; generated content remains local
/data/*
!/data/.gitignore
/artifacts/*
!/artifacts/.gitignore

# Local agent tool state
/.ohmyagent/

# Local MonkeyCode tool state
/.monkeycode/
