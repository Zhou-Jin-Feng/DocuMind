{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documind.local/contracts/p2-representative-review-decisions-v1.schema.json",
  "title": "DocuMind P2 representative human review decision",
  "$defs": {
    "grade_update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "chunk_id", "from_grade", "to_grade"],
      "properties": {
        "document_id": {"type": "string", "pattern": "^p2rep:document:[0-9a-f]{64}$"},
        "chunk_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "from_grade": {"type": "integer", "minimum": 0, "maximum": 3},
        "to_grade": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qrel_grade_updates"],
      "properties": {
        "qrel_grade_updates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/grade_update"}}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "decision", "reviewer", "reviewed_at", "overrides", "notes"],
  "properties": {
    "schema_version": {"const": "p2-representative-review-decision-v1"},
    "candidate_id": {"type": "string", "pattern": "^REP-T(?:0[1-9]|1[0-9]|2[0-5])-(?:0[1-9]|1[0-6])$"},
    "decision": {"enum": ["pending", "approve", "modify", "delete"]},
    "reviewer": {"type": ["string", "null"], "minLength": 1},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "overrides": {"anyOf": [{"$ref": "#/$defs/overrides"}, {"type": "null"}]},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "pending"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "reviewer": {"type": "null"},
          "reviewed_at": {"type": "null"},
          "overrides": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"enum": ["approve", "delete"]}}, "required": ["decision"]},
      "then": {
        "properties": {
          "reviewer": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "format": "date-time"},
          "overrides": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "modify"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "reviewer": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "format": "date-time"},
          "overrides": {"$ref": "#/$defs/overrides"}
        }
      }
    }
  ]
}
